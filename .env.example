# ========================================
# Environment Variables for PromptNest
# ========================================
# Copy this file to .env.local and fill in your values

# Supabase Configuration
SUPABASE_URL=https://acikgnhnbrobkwcebwfb.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here

# Email Settings
EMAIL_FROM=PromptNest <onboarding@resend.dev>

# App URL (for email links)
APP_URL=https://promptnest-app.vercel.app

# ========================================
# How to get these values:
# ========================================
# 
# SUPABASE_SERVICE_KEY:
#   1. Go to https://supabase.com/dashboard
#   2. Select your project
#   3. Go to Settings > API
#   4. Copy the "service_role" key (NOT the anon key)
#
# RESEND_API_KEY:
#   1. Go to https://resend.com/api-keys
#   2. Create a new API key
#   3. Copy the key (starts with "re_")
#
# EMAIL_FROM:
#   - For testing: use "Name <onboarding@resend.dev>"
#   - For production: verify your domain in Resend first
